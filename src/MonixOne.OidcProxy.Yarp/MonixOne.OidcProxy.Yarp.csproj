<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MonixOne.OidcProxy.Yarp</PackageId>
    <Title>MonixOne.OidcProxy.Yarp</Title>
    <RootNamespace>MonixOne.OidcProxy.Yarp</RootNamespace>
    <PackageTags>aspnetcore;bff;spa;yarp;oauth2;openid-connect;openiddict;redis</PackageTags>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <Version>9.0.0</Version>
    <Authors>Albert Starreveld; Shulyakovsky.E</Authors>
    <Company>MonixOne</Company>
    <Copyright>MonixOne contributors; upstream copyright retained</Copyright>
    <Description>A .NET 10 Backend-for-Frontend using YARP, standard OpenID Connect and Redis. Framework Data Protection encrypts server sessions and rotates data keys. Supports signed back-channel logout, coordinated refresh across replicas and host-owned OpenTelemetry. Compatible with OpenIddict.</Description>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryUrl>https://github.com/Shulyakovskiy/MonixOne.OidcProxy.Yarp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Shulyakovskiy/MonixOne.OidcProxy.Yarp</PackageProjectUrl>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>New-deployment session format uses ASP.NET Core Data Protection with shared Redis keys and standard key rotation. No migration reader. Adds signed back-channel logout with configurable limits and atomic replay-safe deletion, read-only session inspection, consistent POST/Basic client authentication, composed OIDC events and built-in Meter/ActivitySource instrumentation. Redis/CAS/YARP architecture, browser API contracts and existing configuration defaults are retained.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="jose-jwt" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Duende.IdentityModel" />
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="StackExchange.Redis" />
    <None Include="../../assets/NuGet.md" Pack="true" PackagePath="/README.md" />
    <None Include="../../assets/nuget-icon.png" Link="nuget-icon.png" Pack="true" PackagePath="/" />
    <None Include="../../license.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
