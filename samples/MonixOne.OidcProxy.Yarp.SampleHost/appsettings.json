{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "Bff": {
    "ApplicationName": "sample-spa",
    "KeyNamespace": "web",
    "EncryptionKey": "",
    "Clients": {
      "spa": {
        "PublicOrigin": "https://localhost:5001",
        "PathBase": "",
        "OpenIdConnect": {
          "Authority": "https://identity.example.com",
          "ClientId": "spa-bff",
          "Scope": [
            "openid",
            "profile",
            "offline_access",
            "api.read"
          ]
        }
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "resource-api",
        "Match": {
          "Path": "/api/{**all}",
          "Hosts": [
            "localhost:5001"
          ]
        },
        "Metadata": {
          "OidcProxy.Client": "spa"
        }
      }
    },
    "Clusters": {
      "resource-api": {
        "Destinations": {
          "primary": {
            "Address": "https://localhost:7001/"
          }
        }
      }
    }
  }
}
