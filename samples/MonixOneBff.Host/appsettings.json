{
  "ProjectName": "MonixOne.Sample",
  "RedisNamespace": "web-bff",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning"
    }
  },
  "OidcProxy": {
    "CustomHostName": "https://localhost:5001",
    "Oidc": {
      "Authority": "https://identity.example",
      "ClientId": "web-bff",
      "Scopes": ["profile-service.full_access"]
    },
    "ReverseProxy": {
      "Routes": {
        "api": { "ClusterId": "gateway", "Match": { "Path": "/api/{**all}" } }
      },
      "Clusters": {
        "gateway": { "Destinations": { "primary": { "Address": "https://localhost:7001/" } } }
      }
    }
  }
}
