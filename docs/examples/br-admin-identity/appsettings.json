{
  "AllowedHosts": "admin-dev.intra-beetroute.ru",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8000"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "Bff": {
    "ApplicationName": "br-spa-gateway",
    "KeyNamespace": "bff",
    "EncryptionKey": "",
    "Clients": {
      "adminidentity": {
        "PublicOrigin": "https://admin-dev.intra-beetroute.ru",
        "PathBase": "/admin",
        "SessionIdleTimeout": "00:20:00",
        "SessionAbsoluteTimeout": "08:00:00",
        "OpenIdConnect": {
          "Authority": "https://id-dev.intra-beetroute.ru/",
          "ClientId": "br-admin-identity-bff",
          "Scope": [
            "openid",
            "offline_access",
            "profile-service.full_access",
            "location-service.full_access",
            "storage-service.full_access"
          ]
        },
        "CookiePolicies": {
          "calendar-google": {
            "ClusterId": "admin-backend",
            "Names": [
              "calendar_google_state"
            ],
            "Path": "/calendar-api/connections/google/callback",
            "SameSite": "Lax",
            "MaxAge": "00:10:00"
          }
        },
        "Routes": {
          "google-start": {
            "AllowAnonymous": false,
            "CookiePolicy": "calendar-google"
          },
          "google-callback": {
            "AllowAnonymous": true,
            "CookiePolicy": "calendar-google"
          },
          "calendar": {
            "AllowAnonymous": false
          },
          "resource-apis": {
            "AllowAnonymous": false
          },
          "spa": {
            "AllowAnonymous": true
          }
        }
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "google-start": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/connections/google/start",
          "Methods": [
            "POST"
          ]
        }
      },
      "google-callback": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/connections/google/callback",
          "Methods": [
            "GET"
          ]
        }
      },
      "calendar": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/{**path}"
        }
      },
      "resource-apis": {
        "ClusterId": "beetroute-apis",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/api/{**path}"
        }
      },
      "spa": {
        "ClusterId": "admin-backend",
        "Order": 100,
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/{**path}"
        }
      }
    },
    "Clusters": {
      "admin-backend": {
        "Destinations": {
          "primary": {
            "Address": "http://stack-srv-admin-identity-dev_admin-identity:8000/"
          }
        }
      },
      "beetroute-apis": {
        "Destinations": {
          "primary": {
            "Address": "https://gw-dev.intra-beetroute.ru/"
          }
        }
      }
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "10.0.0.10"
    ],
    "AllowedHosts": [
      "admin-dev.intra-beetroute.ru"
    ]
  }
}
