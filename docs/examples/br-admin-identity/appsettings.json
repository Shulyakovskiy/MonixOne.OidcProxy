{
  "AllowedHosts": "admin-dev.intra-beetroute.ru",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:8443"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "Bff": {
    "ApplicationName": "br-spa-gateway",
    "KeyNamespace": "bff",
    "Clients": {
      "adminidentity": {
        "PublicOrigin": "https://admin-dev.intra-beetroute.ru",
        "PathBase": "/admin",
        "SessionIdleTimeout": "00:20:00",
        "SessionAbsoluteTimeout": "08:00:00",
        "OpenIdConnect": {
          "Authority": "https://id-dev.intra-beetroute.ru/",
          "ClientId": "br-admin-identity-bff",
          "Scope": [
            "openid",
            "offline_access",
            "profile-service.full_access",
            "location-service.full_access",
            "storage-service.full_access"
          ]
        },
        "CookiePolicies": {
          "calendar-google": {
            "ClusterId": "admin-backend",
            "Names": [
              "calendar_google_state"
            ],
            "Path": "/calendar-api/connections/google/callback",
            "SameSite": "Lax",
            "MaxAge": "00:10:00"
          }
        }
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "google-start": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/connections/google/start",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "OidcProxy.Client": "adminidentity",
          "OidcProxy.CookiePolicy": "calendar-google"
        }
      },
      "google-callback": {
        "ClusterId": "admin-backend",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/connections/google/callback",
          "Methods": [
            "GET"
          ]
        },
        "Metadata": {
          "OidcProxy.Client": "adminidentity",
          "OidcProxy.CookiePolicy": "calendar-google"
        }
      },
      "calendar": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/calendar-api/{**path}"
        },
        "Metadata": {
          "OidcProxy.Client": "adminidentity"
        }
      },
      "resource-apis": {
        "ClusterId": "beetroute-apis",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/api/{**path}"
        },
        "Metadata": {
          "OidcProxy.Client": "adminidentity"
        }
      },
      "spa": {
        "ClusterId": "admin-backend",
        "Order": 100,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Hosts": [
            "admin-dev.intra-beetroute.ru"
          ],
          "Path": "/{**path}"
        },
        "Metadata": {
          "OidcProxy.Client": "adminidentity"
        }
      }
    },
    "Clusters": {
      "admin-backend": {
        "Destinations": {
          "primary": {
            "Address": "https://admin-identity-backend.internal.invalid/"
          }
        }
      },
      "beetroute-apis": {
        "Destinations": {
          "primary": {
            "Address": "https://gw-dev.intra-beetroute.ru/"
          }
        }
      }
    }
  }
}
