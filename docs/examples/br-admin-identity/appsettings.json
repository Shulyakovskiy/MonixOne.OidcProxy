{
  // Полный пример для нового внедрения. ASP.NET Core поддерживает комментарии в JSON.
  // Адреса/имена ниже — профиль BR.Admin-Identity; замените их для своего окружения.
  // Секреты пустые: задавайте их через environment/secret provider, не через этот файл.

  // Host filtering ASP.NET Core: допустимые публичные hostname, без схемы и PathBase.
  "AllowedHosts": "admin.id-dev.intra-beetroute.ru",
  "Kestrel": {
    "Endpoints": {
      // В этом профиле TLS завершается на доверенном ingress; BFF всё равно видит HTTPS
      // через проверенные forwarded headers. Для прямого HTTPS используйте штатный Kestrel.
      "Http": { "Url": "http://0.0.0.0:8000" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MonixOne.OidcProxy.Yarp": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Authentication.OpenIdConnect": "Warning",
      "Yarp.ReverseProxy.Forwarder.HttpForwarder": "Warning"
    }
  },
  "ConnectionStrings": {
    // Общий Redis для всех реплик. Пример переменной: ConnectionStrings__Redis.
    // Строку, включая TLS/ACL и таймауты StackExchange.Redis, задаёт secret provider.
    "Redis": ""
  },
  "Bff": {
    // Путь к значению конфигурации со строкой Redis. Это имя ключа, не сама строка.
    // При уже зарегистрированном host-owned ConnectionMultiplexer используется он.
    "RedisConnectionStringKey": "ConnectionStrings:Redis",
    // Изоляция приложения в Redis/Data Protection: 1–64 ASCII букв/цифр/._-.
    "ApplicationName": "br-spa-gateway",
    // EnvironmentName берётся из IHostEnvironment, например ASPNETCORE_ENVIRONMENT.
    // Bff:EnvironmentName в configuration overload не переопределяет окружение host.
    // Дополнительная изоляция независимых BFF. Scope одинаков на всех его репликах.
    "KeyNamespace": "bff",
    // Пароль защиты framework key ring, не ClientSecret и не raw AES key.
    // Bff__EncryptionKey — сильный случайный секрет, одинаковый на всех репликах.
    // Не нужен при штатном host AddDataProtection().ProtectKeysWithCertificate(...).
    "EncryptionKey": "",
    "Clients": {
      // Имя клиента: 1–64 lowercase ASCII букв/цифр/._-. Вторую SPA добавляют соседним ключом.
      "adminidentity": {
        // Точный публичный HTTPS origin. Без path/query/fragment. Host/port уникален среди клиентов.
        "PublicOrigin": "https://admin.id-dev.intra-beetroute.ru",
        // Канонический URI-escaped префикс без завершающего /. Пустая строка — корень.
        // YARP Match.Path задаётся после снятия этого префикса.
        "PathBase": "/admin",
        // Idle от последнего принятого защищённого запроса. Проверка me?slide=false его не продлевает.
        "SessionIdleTimeout": "00:20:00",
        // Абсолютный предел от создания сессии, не продлевается refresh.
        // >= idle, оба > 0; текущий верхний предел absolute — 365 дней.
        "SessionAbsoluteTimeout": "08:00:00",
        // Фиксированный срок cookie и Redis при явном rememberMe=true; без короткого idle.
        // > 0 и <= 365 дней; refresh и активность не продлевают срок.
        "RememberedSessionTimeout": "30.00:00:00",
        // Общий серверный бюджет refresh и deadline pending marker. Одинаков на репликах.
        "RefreshTimeout": "00:00:30",
        // Бюджет создания/удаления сессии и очистки неудачного входа, независимо от disconnect.
        "SessionStoreTimeout": "00:00:05",
        // Бюджет best-effort отзыва refresh token у IdP. Успех отзыва не гарантируется.
        "TokenRevocationTimeout": "00:00:05",
        // PostBody = client_secret_post; AuthorizationHeader = client_secret_basic.
        // Один способ используется для PAR, code exchange, refresh и revocation.
        "ClientCredentialStyle": "PostBody",
        "OpenIdConnect": {
          // HTTPS issuer/authority IdP. Discovery/JWKS получает стандартный OIDC handler.
          "Authority": "https://id-dev.intra-beetroute.ru/",
          // Необязательный альтернативный discovery URL; null — вычислить из Authority.
          "MetadataAddress": null,
          // Confidential client, зарегистрированный у IdP именно для этой SPA/BFF.
          "ClientId": "br-admin-identity-bff",
          // Bff__Clients__adminidentity__OpenIdConnect__ClientSecret — только secret provider.
          "ClientSecret": "",
          // Явный список заменяет стандартные openid/profile; openid обязателен для BFF.
          // offline_access и разрешённый refresh grant нужны для продления токенов.
          "Scope": [
            "openid",
            "offline_access",
            "profile-service.full_access",
            "location-service.full_access",
            "storage-service.full_access"
          ],
          // Штатный HTTP timeout IdP (discovery, token, revocation), отдельный от RefreshTimeout.
          "BackchannelTimeout": "00:00:10",
          // Штатный срок завершения удалённой аутентификации/correlation, не idle сессии.
          "RemoteAuthenticationTimeout": "00:15:00",
          // Дополнительные claims через UserInfo; включать только при необходимости и поддержке IdP.
          "GetClaimsFromUserInfoEndpoint": false,
          // Запросить обновление metadata при неизвестном signing key. Частоту ограничивает framework.
          "RefreshOnIssuerKeyNotFound": true,
          // PAR: UseIfAvailable / Disable / Require. Штатный механизм ASP.NET Core.
          "PushedAuthorizationBehavior": "UseIfAvailable",
          "TokenValidationParameters": {
            // Claim для Identity.Name и IsInRole/role-based authorization соответственно.
            "NameClaimType": "name",
            "RoleClaimType": "role",
            // Допустимое расхождение часов при проверке ID token.
            // У back-channel logout отдельный ClockSkew ниже.
            "ClockSkew": "00:01:00"
          }
          // Протокол фиксирует BFF: Code+PKCE, query response, HTTPS metadata,
          // SaveTokens=true, MapInboundClaims=false, signed tokens и issuer/audience/lifetime validation.
          // CallbackPath=/.auth/login/callback, SignedOutCallbackPath=/.auth/signout-callback;
          // публичные URL включают PublicOrigin + PathBase. RemoteSignOutPath отключён.
          // Events настраиваются кодом host; EventsType не поддерживается.
          // Остальные совместимые свойства — стандартные OpenIdConnectOptions, без собственной модели BFF.
        },
        "BackchannelLogout": {
          // Верхняя граница form body в байтах, включая URL encoding и имена параметров.
          "MaximumRequestBodyBytes": 65536,
          // Верхняя граница compact JWT в символах до проверки подписи.
          "MaximumTokenLength": 32768,
          // Максимальный возраст iat, в том числе у logout token без exp.
          "MaximumTokenAge": "00:05:00",
          // Допуск часов для iat и стандартной проверки lifetime logout token.
          "ClockSkew": "00:01:00",
          // Серверный бюджет локального удаления после проверки подписи.
          "ProcessingTimeout": "00:00:05",
          // Удержание успешного jti. Строго больше MaximumTokenAge + ClockSkew.
          // Дубликат не должен закрыть более поздний вход пользователя.
          "ReplayRetention": "00:10:00",
          // Не больше этого числа записей удаляет один атомарный Redis script.
          "BatchSize": 100,
          // Не больше этого числа пакетов за запрос. При исчерпании — 503; повтор продолжает удаление.
          "MaximumBatches": 100
        },
        // Автоматический cookie bridge для доверенных backend: изоляция по client/cluster/path.
        // По умолчанию false; явная CookiePolicy конкретного route имеет приоритет.
        "ForwardCookies": true,
        // Точные YARP Hosts автоматически связывают route с клиентом.
        // При отсутствии Routes включается автоматически; явные bindings имеют приоритет.
        "AutoBindRoutes": true,
        "Routes": {
          // Ключ — существующий YARP RouteId, один владелец BFF. Остальная маршрутизация — в ReverseProxy.
          // CookiePolicy можно не указывать: тогда работает ForwardCookies или cookies удаляются.
          "resource-apis": { "AllowAnonymous": false },
          "calendar": { "AllowAnonymous": false, "CookiePolicy": "google-oauth" },
          // Только точный callback с ограниченным HTTP method доступен без BFF-сессии.
          "google-callback": { "AllowAnonymous": true, "CookiePolicy": "google-oauth" },
          "spa": { "AllowAnonymous": true }
        },
        "CookiePolicies": {
          // Необязательный узкий bridge. Не нужен, когда достаточно ForwardCookies.
          "google-oauth": {
            // Единственный cluster, в который можно отправить эти cookies.
            "ClusterId": "admin-backend",
            // Точные backend-имена или непустой prefix с завершающей *. Не имя BFF-cookie.
            "Names": ["calendar_google_state"],
            // Серверная граница forwarding относительно PathBase; browser cookie всегда Path=/.
            "Path": "/calendar-api/connections/google",
            // Минимальная защита: None / Lax / Strict; более строгий backend SameSite сохраняется.
            "SameSite": "Lax",
            // Верхний предел существующего persistent lifetime. null — не ограничивать дополнительно.
            // > 0 и <= 365 дней. Не продлевает backend lifetime и не превращает session cookie в persistent.
            "MaxAge": "00:10:00"
          }
        }
      }
    }
  },
  "ReverseProxy": {
    // Штатная конфигурация YARP; пакет не создаёт вторую модель routing/transport.
    "Routes": {
      "google-callback": {
        "ClusterId": "admin-backend",
        "Match": {
          // Точный authority PublicOrigin, включая нестандартный порт. Wildcards для BFF не допускаются.
          "Hosts": ["admin.id-dev.intra-beetroute.ru"],
          "Path": "/calendar-api/connections/google/callback",
          "Methods": ["GET"]
        },
        // Штатная публичная policy YARP. Bff Routes.AllowAnonymous согласован с ней.
        "AuthorizationPolicy": "anonymous"
      },
      "calendar": {
        "ClusterId": "admin-backend",
        "Match": {
          "Hosts": ["admin.id-dev.intra-beetroute.ru"],
          "Path": "/calendar-api/{**path}"
        }
      },
      "resource-apis": {
        "ClusterId": "beetroute-apis",
        "Match": {
          "Hosts": ["admin.id-dev.intra-beetroute.ru"],
          "Path": "/api/{**path}"
        }
      },
      "spa": {
        "ClusterId": "admin-backend",
        // Более высокое значение — более низкий приоритет относительно узких API/callback routes.
        "Order": 100,
        "Match": {
          "Hosts": ["admin.id-dev.intra-beetroute.ru"],
          "Path": "/{**path}"
        },
        "AuthorizationPolicy": "anonymous"
      }
    },
    "Clusters": {
      "admin-backend": {
        // Один или несколько destination; балансировку/health checks при необходимости настраивает host через YARP.
        "Destinations": {
          // Внутренний HTTP разрешён в доверенной сети после TLS termination; TLS-проверка HTTPS не отключается.
          "primary": { "Address": "http://stack-srv-admin-identity-dev_admin-identity:8000/" }
        }
      },
      "beetroute-apis": {
        "Destinations": {
          "primary": { "Address": "https://gw-dev.intra-beetroute.ru/" }
        }
      }
    }
  },
  "ForwardedHeaders": {
    // false: принимать forwarded headers только от KnownProxies/KnownIPNetworks.
    // true: доверять любому непосредственному proxy; списки адресов игнорируются.
    // true допустимо только за изолированным ingress без прямого доступа клиентов к BFF.
    // Штатный ForwardLimit = 1 сохраняется; AllowedHosts применяется в обоих режимах.
    "TrustAllProxies": false,
    // Только реальные адреса доверенного ingress/proxy. Здесь пример — замените для своего развертывания.
    "KnownProxies": ["10.0.0.10"],
    // Дополнительные доверенные CIDR-сети, например сеть ingress. Пусто — дополнительных сетей нет.
    "KnownIPNetworks": [],
    // Разрешённые X-Forwarded-Host, hostname без схемы и PathBase.
    "AllowedHosts": ["admin.id-dev.intra-beetroute.ru"]
  },
  "Cors": {
    // Для native API/GW. BFF остаётся same-origin; CORS не расширяет его Origin-проверку.
    // Для same-origin BFF отдельные origins не нужны. Не открывайте credentialed CORS произвольным сайтам.
    // Пакет регистрирует named policy; UseCors(OidcProxyDefaults.CorsPolicy) включает host в pipeline callback.
    "Origins": []
  }
}
